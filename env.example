# Wazuh AI Agent Configuration
# Auto-generated from docker-compose.yml
# Generated on: 2026-06-18 15:00:22
#
# To run locally:
#   export $(cat .env | grep -v '^#' | xargs)
#   python3 agentic_soc.py

# ===== OpenSearch Configuration =====
OPENSEARCH_INDEXES=wazuh-alerts-*,wazuh-monitoring-*,wazuh-states-vulnerabilities-*,wazuh-states-inventory-*
OPENSEARCH_PASSWORD=your_opensearch_password
OPENSEARCH_URL=https://wazuh_IP:9200
OPENSEARCH_USER=read_only_user
OPENSEARCH_VERIFY_SSL=false

# ===== LiteLLM Configuration =====
LITELLM_API_BASE=litellm_instance_URL
LITELLM_API_KEY=your_api_key
LITELLM_MODEL=your_AI_model

# ===== Web UI Authentication =====
WEB_PASSWORD=your_password_for_web_UI
WEB_USERNAME=admin

# ===== Auto-Refresh Configuration =====
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_INTERVAL=15

# ===== Daily Email Reports =====
DAILY_REPORT_TIME=07:00
SENDGRID_API_KEY=your_api_key
SENDGRID_FROM_EMAIL=from_email
SENDGRID_TO_EMAILS=to_email

# ===== Other Configuration =====
# Time range for data loading (in days)
# 0.25 = 6 hours (optimal for AI context window - ~87K records)
# 0.5 = 12 hours (~175K records)
# 1 = 24 hours (~350K records - may overflow context)
DAYS_RANGE=0.25
PYTHONUNBUFFERED=1

